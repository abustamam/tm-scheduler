.gstack/
# /retro writes its weekly snapshots here. Same class as .gstack/ above: local
# telemetry about how the work went, not about the product. Every other gstack
# per-project artifact (ship metrics, decision log, design archives) already
# lives in ~/.gstack/projects/<slug>/, so committing these would split that data
# across two homes. Note the tradeoff: ignored files do not reach worktrees, so
# run /retro from the main checkout or it reports "first retro" every time.
.context/
.claude/*

# design-sync (claude.ai/design) build artifacts — durable inputs live in .design-sync/ and ARE committed
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/compiled-styles.css
.superpowers/

# Local reference data (Toastmasters membership CSV exports — contain member PII;
# consumed by scripts/import-members.ts but never committed)
#
# No trailing slash on purpose. `ref/` matches directories ONLY, so a plain file
# or a SYMLINK named `ref` was not ignored — and `bun run worktree:setup`
# symlinks this into every worktree, which would have left member PII one
# `git add` away from being committed. Bare `ref` covers file, directory and
# symlink alike; nothing tracked is named `ref`, so this loses no coverage.
ref

# HAR captures contain live Base Camp session tokens (sessionid/ApiToken/edx-jwt).
# Keep them local; the non-secret request recipe lives in issue #107. The scrubbed
# samples/_api_bcm_progress_* JSON fixtures ARE committed for reference.
*.har
.codeledger/*
!.codeledger/
!.codeledger/bin/
!.codeledger/bin/**
!.codeledger/team-ledger/
!.codeledger/team-ledger/**
.claude/*
!.claude/
!.claude/hooks.json
# Project skills are shared agent procedure, like docs/agents/ — they belong in
# the repo. Everything else under .claude/ is per-session local state (worktrees
# above all, which would otherwise recurse into this ignore file).
!.claude/skills/
!.claude/skills/**
CLAUDE.local.md
.release-worktree/
