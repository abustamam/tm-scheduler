{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^(Agent|Task)$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PROJECT_DIR:-.}/scripts/agent-model-guard.ts\"",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PROJECT_DIR:-.}/scripts/implementer-context-guard.ts\"",
						"timeout": 10
					}
				]
			}
		]
	}
}
